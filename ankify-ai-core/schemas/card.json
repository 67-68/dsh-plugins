{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ankify-ai.local/schemas/card.json",
  "title": "Card",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "front": {
      "type": "string",
      "minLength": 1,
      "description": "基础卡片正面：最小检索键，一行以内，问句或填空；format=cloze-list 时作为该组 cloze 的问题。"
    },
    "back": {
      "type": "string",
      "minLength": 1,
      "description": "基础卡片背面：最短答案，一个词/数字/短句。format=cloze-list 时不需要。"
    },
    "format": {
      "type": "string",
      "enum": [
        "basic",
        "cloze-list"
      ],
      "default": "basic",
      "description": "basic=普通 front/back 卡片；cloze-list=有限列表，Raycast 会渲染成 #### [cloze] {front} 加列表项。"
    },
    "cloze_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 8,
      "description": "format=cloze-list 时按顺序排列的列表项；front 同时给出这组列表的问题。"
    },
    "type": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "A3",
        "A4",
        "B1",
        "B2",
        "B3",
        "B4",
        "B5",
        "B6",
        "B7",
        "B8"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "extra": {
      "type": "string",
      "description": "背景、助记、来源等，不作考点，放在答案后括号里。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "cloze-list"
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "required": [
          "cloze_items"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "format": {
              "const": "cloze-list"
            }
          },
          "required": [
            "format"
          ]
        }
      },
      "then": {
        "required": [
          "front",
          "back"
        ]
      }
    }
  ],
  "additionalProperties": true
}
