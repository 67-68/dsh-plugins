{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ankify-ai.local/schemas/ankify_result.json",
  "title": "AnkifyResult",
  "type": "object",
  "required": ["cards", "pipeline"],
  "properties": {
    "cards": {
      "type": "array",
      "items": { "$ref": "card.json" },
      "minItems": 1
    },
    "pipeline": {
      "type": "string",
      "enum": ["single-pass", "two-pass"]
    },
    "source_summary": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "模型认为需要人工确认的地方。",
      "default": []
    }
  },
  "additionalProperties": true
}
