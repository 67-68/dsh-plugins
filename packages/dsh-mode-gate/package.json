{
  "name": "dsh-mode-gate",
  "description": "Multi-workflow mode gate: IDLE / SIMPLE-ACTION / CREATE flat state machine with goal engine, workflow registry, feature-intent checklist plans and model switching",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "workflows"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <0.2.0",
    "react": "^18.2.0"
  }
}
